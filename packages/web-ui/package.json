{
  "name": "@isaacrmoreno/cinder-ui",
  "version": "0.1.0",
  "description": "Reusable website sections for Cinder managed small-business websites.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacrmoreno/cinder-ui.git",
    "directory": "packages/web-ui"
  },
  "homepage": "https://github.com/isaacrmoreno/cinder-ui#readme",
  "bugs": {
    "url": "https://github.com/isaacrmoreno/cinder-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "website",
    "cinder"
  ]
}
